# Public HTTPS origin used by Claude / ChatGPT to connect to the MCP endpoint
# and by the widget iframe to load /images/*. Required for remote (web AI) use.
PUBLIC_BASE_URL=https://sticker.example.com
PORT=3000

# Streamable HTTP MCP route. /mcp is always kept as an alias for local smoke tests.
MCP_HTTP_PATH=/mcp/sticker

# CORS allowlist (comma separated). Defaults to the PUBLIC_BASE_URL origin.
ALLOWED_ORIGINS=https://sticker.example.com

# Allowed Host header names (not URLs). Keep this aligned with the public
# hostname; localhost/loopback are included automatically for health checks.
ALLOWED_HOSTS=sticker.example.com

# Usually leave empty. Only set after a dedicated HTTPS widget origin exists.
MCP_WIDGET_DOMAIN=

# Optional OAuth password gate for remote connectors.
# Leave empty to disable auth; set a password to enable Authorization Code auth.
MCP_AUTH_PASSWORD=
# Stable high-entropy signing secret. Keep unchanged across upgrades.
MCP_AUTH_TOKEN_SECRET=
MCP_AUTH_SERVICE_NAME=sticker-mcp
MCP_OAUTH_SCOPE=tools:read tools:write
# Keep true during migration; set false after every client sends RFC 8707 resource.
MCP_OAUTH_ALLOW_LEGACY_RESOURCE_OMISSION=true

# Where stickers.json and images/ live.
DATA_DIR=/app/data

# Optional: protect /api/* with a token. /admin is a data-free HTML shell that
# asks for this value and sends it only in the Authorization header.
ADMIN_TOKEN=
